#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
if [ -z "${NGRAM_WEB_PYTHON:-}" ] && [ -x .venv/bin/python ]; then
  export NGRAM_WEB_PYTHON="$PWD/.venv/bin/python"
fi
exec "${NGRAM_WEB_PYTHON:-python3}" -m uvicorn server.app:app --host 127.0.0.1 --port "${NGRAM_WEB_PORT:-8765}" --workers 1
